{
  "name": "Shiny Rock Chat",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "workspace",
  "workspaceFolder": "/workspaces/shiny-rock-chat",
  "runServices": ["workspace", "db", "turn"],
  "shutdownAction": "stopCompose",
  "remoteUser": "root",
  "postCreateCommand": "cd backend && go mod download && cd ../client && flutter pub get",
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter",
        "golang.Go",
        "redhat.vscode-yaml"
      ]
    }
  }
}
